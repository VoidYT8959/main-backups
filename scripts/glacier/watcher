#!/usr/bin/env python3
import os
import time
import subprocess

check_script = os.path.expanduser("~/scripts/glacier/collision-check")
state_file = os.path.expanduser("~/scripts/glacier/state")
last_state = None

while True:
    result = subprocess.run([check_script], capture_output=True, text=True)
    state = result.stdout.strip().splitlines()[-1] if result.stdout.strip() else "CLEAR"
    if state != last_state:
        with open(state_file, "w") as f:
            f.write(state + "\n")
        last_state = state
    time.sleep(0.10)
